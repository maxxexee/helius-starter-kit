# Required. Create a key at https://dashboard.helius.dev
HELIUS_API_KEY=

# Optional. One of: mainnet-ewr, mainnet-pitt, mainnet-slc, mainnet-lax,
# mainnet-lon, mainnet-ams, mainnet-fra, mainnet-tyo, mainnet-sgp, devnet-ewr.
# Pick the region closest to the machine running this. Default: devnet-ewr.
LASERSTREAM_ENDPOINT=devnet-ewr

# Optional. Force a disconnect this many ms in, to exercise replay. 0 disables.
DROP_AFTER_MS=15000

# Optional. Stop and print the report after this many ms. 0 runs until Ctrl-C.
RUN_MS=45000

# Optional. Jump size in slots that counts as a suspicious gap. Default 5.
SUSPICIOUS_GAP_SLOTS=5

# Optional. Consecutive failed connects before giving up. Default 5.
MAX_RECONNECT_ATTEMPTS=5
